<Window x:Class="WinDock.LaunchpadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launchpad" WindowStyle="None" AllowsTransparency="True" Background="#E0101014"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <Style x:Key="AppButton" TargetType="Button">
            <Setter Property="Width" Value="132"/>
            <Setter Property="Height" Value="128"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#38FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="80,48,80,120">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Width="300" Margin="0,0,0,32" CornerRadius="10" Background="#26FFFFFF" BorderBrush="#30FFFFFF" BorderThickness="1">
            <Grid>
                <TextBlock x:Name="SearchHint" Text="Search" Foreground="#99FFFFFF" FontSize="14" Margin="14,7" IsHitTestVisible="False"/>
                <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White"
                         FontSize="14" Padding="10,7" TextChanged="Search_TextChanged"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Apps">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource AppButton}" Click="App_Click" MouseRightButtonUp="App_RightClick">
                            <StackPanel>
                                <Image Source="{Binding Icon}" Width="64" Height="64" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock Text="{Binding Name}" Foreground="White" FontSize="12.5" Margin="6,10,6,0"
                                           TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="34"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
