<Window x:Class="WinDock.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDock" Icon="icon.ico" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="#1C1C1E" Foreground="#F2F2F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="28,24,28,26">
        <Image Source="icon.png" Width="64" Height="64" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock Text="Welcome to WinDock" FontSize="22" FontWeight="SemiBold" Margin="0,16,0,0"
                   FontFamily="Segoe UI Variable Display, Segoe UI"/>
        <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,20"
                   Text="A Mac-style dock for Windows, plus a one-click way to hide your desktop icons. Use either or both."/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Border Style="{StaticResource Row}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Right-click the dock for everything"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Settings, pinning apps, and Turn Off WinDock all live there."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="Drag icons to rearrange them"/>
                        <TextBlock Style="{StaticResource Hint}" Text="The dock starts with the apps pinned to your Windows taskbar."/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Row}" Padding="14,10" BorderThickness="0">
                    <StackPanel>
                        <TextBlock Text="Find it in the Start menu"/>
                        <TextBlock Style="{StaticResource Hint}" Text="Opening WinDock while it is running brings up its settings."/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="DockEnabled" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Dock"/>
                            <TextBlock Style="{StaticResource Hint}" Text="The Mac-style dock at the bottom of the screen."/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}" BorderThickness="0">
                    <CheckBox x:Name="IconButton" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Desktop icons button"/>
                            <TextBlock Style="{StaticResource Hint}" Text="A small floating button that hides and shows your desktop icons."/>
                        </StackPanel>
                    </CheckBox>
                </Border>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <Border Style="{StaticResource Row}">
                    <CheckBox x:Name="HideTaskbar" IsChecked="True">
                        <StackPanel>
                            <TextBlock Text="Hide the Windows taskbar"/>
                            <TextBlock Style="{StaticResource Hint}" Text="The clock and system tray hide with it. Turning WinDock off puts the taskbar back exactly as it was."/>
                        </StackPanel>
                    </CheckBox>
                </Border>
                <Border Style="{StaticResource Row}" BorderThickness="0">
                    <CheckBox x:Name="StartWithWindows" IsChecked="True" Content="Start WinDock when I sign in"/>
                </Border>
            </StackPanel>
        </Border>

        <Grid Margin="0,22,0,0">
            <TextBlock Style="{StaticResource Hint}" Text="You can change all of these later in settings." VerticalAlignment="Center" Margin="2,0,0,0"/>
            <Button Style="{StaticResource AccentButton}" Content="Get started" Click="Start_Click" IsDefault="True" HorizontalAlignment="Right"/>
        </Grid>
    </StackPanel>
</Window>
